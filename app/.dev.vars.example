# Copy locally to .dev.vars (ignored). Register a separate development GitHub App.
APP_ORIGIN=http://localhost:8787
GITHUB_CLIENT_ID=YOUR_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_APP_CLIENT_SECRET
GITHUB_APP_URL=https://github.com/apps/YOUR_APP_SLUG
SESSION_KEY=GENERATE_A_BASE64URL_ENCODED_32_BYTE_KEY
GITHUB_WEBHOOK_SECRET=GENERATE_A_RANDOM_WEBHOOK_SECRET
