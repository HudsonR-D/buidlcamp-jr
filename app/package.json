{
  "name": "buidlcamp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/build-offline.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "start": "node server.mjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "format": "prettier --write src tests server scripts worker public/theme.js *.mjs *.ts *.html *.json *.jsonc",
    "format:check": "prettier --check src tests server scripts worker public/theme.js *.mjs *.ts *.html *.json *.jsonc",
    "test:release": "node tests/release-browser.cjs",
    "review:program": "node --experimental-strip-types scripts/program-audit.ts",
    "review:licenses": "node scripts/license-notices.mjs",
    "test:accessibility": "node tests/accessibility.cjs",
    "review:privacy": "node scripts/privacy-page.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.132.0"
  }
}
